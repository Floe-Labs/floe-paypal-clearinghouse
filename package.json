{
  "name": "floe-paypal-clearinghouse",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Autonomous AI Work Clearinghouse & Programmable Escrow on PayPal Orders v2, Payouts & Disputes APIs",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "npm run build && node dist/apps/clearinghouse-workbench/src/server.js",
    "dev": "npm run build && node dist/apps/clearinghouse-workbench/src/server.js",
    "demo": "npm run build && node dist/apps/clearinghouse-workbench/src/cli-demo.js",
    "test": "vitest run --maxWorkers=10",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
